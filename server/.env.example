# Port the server will run on (defaults to 3001 if not set)
PORT=3001

# Gemini API Key (Required for backend proxy endpoints /analyze and /transcribe)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://server-six-teal-95.vercel.app,https://surokkhaai.web.app,https://surokkhaai.firebaseapp.com
